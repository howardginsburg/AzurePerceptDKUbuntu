# percept-kit settings. Copy config.example/ to config/ (git-ignored), set what you need, then run
#   ./percept-kit.sh deploy
# Every setting is optional: commented out or empty, it keeps the default shown. Files that settings
# refer to (models, certificates, password files) go in config/files/; the containers see
# config/files/<name> as /config/files/<name>. Format: KEY=value, one per line, no quotes.

# ---------------------------------------------------------------- building the images
# Python package index for the mouth and voice images (a mirror or proxy of PyPI).
#PIP_INDEX_URL=https://pypi.org/simple

# ---------------------------------------------------------------- MQTT (the Eye and the voice sample)
# Empty: the device's own broker (container mosquitto, reachable only by the device's containers).
# Otherwise your broker: mqtt://host[:1883], mqtts://host[:8883], ws://host[:80]/path, wss://host[:443]/path
# Azure IoT Hub works too: see customize.md, "Send the results to Azure IoT Hub".
#MQTT_URL=
#MQTT_USERNAME=
# The password, alone on the first line of a file
#MQTT_PASSWORD_FILE=/config/files/mqtt-password
# TLS (mqtts:// and wss://): the CA that signed the broker's certificate (default: the system CAs),
# and a client certificate and key for brokers that require them
#MQTT_CA_FILE=/config/files/ca.pem
#MQTT_CERT_FILE=/config/files/client.pem
#MQTT_KEY_FILE=/config/files/client.key
# 1 = don't verify the broker's certificate (testing only)
#MQTT_INSECURE=0
# Topic the Eye publishes inferences to, and the voice sample reads them from
#MQTT_EYE_TOPIC=percept/eye/inferences
# The voice sample publishes <prefix>/commands and <prefix>/events
#MQTT_VOICE_PREFIX=percept/voice
# The Eye's own MQTT options
#EYE_MQTT_CLIENT_ID=eye-<container id>
#EYE_MQTT_KEEPALIVE=60
#EYE_MQTT_RETAIN=0

# ---------------------------------------------------------------- Eye: model and video
# Model: /config/files/<file> (.zip package, .blob, .xml with its .bin beside it, .onnx) or an
# http(s):// URL to a .zip. Empty: the built-in SSD MobileNet v2 (COCO).
#EYE_MODEL=
# How to read the model's output: ssd100, ssd200, yolo, classification, s1, openpose, onnxssd,
# faster-rcnn-resnet50, unet, ocr. Empty: from the model package, or ssd100.
#EYE_PARSER=
# Label file, one class name per line. Empty: from the model package, or the COCO labels.
#EYE_LABELS=
# Camera mode and stream resolution: native (816x616 video), 1080p or 720p
#EYE_RESOLUTION=native
# Video frame rate
#EYE_FPS=10
# 1 = delay the video so boxes line up exactly with their frame
#EYE_TIME_ALIGN=0
# 1 = stop on an incompatible model instead of falling back to the default SSD
#EYE_STRICT_MODEL=0

# ---------------------------------------------------------------- Eye: inference outputs
# Send at most one message every N ms to MQTT, HTTP and stdout (0 = every inference, about 12 a second)
#EYE_OUTPUT_INTERVAL_MS=0
# 1 = one JSON line per inference in `docker logs eye`
#EYE_STDOUT=0
# How often /metrics reads the Myriad X's temperatures and memory, in ms (0 = never)
#EYE_VPU_TELEMETRY_MS=5000

# ---------------------------------------------------------------- Ear
# Seconds between JSON level lines in `docker logs ear` (0 = off)
#EAR_LOG_LEVELS=0

# ---------------------------------------------------------------- mouth (speaker and Bluetooth)
# Voice: a Piper voice in the image, or an espeak-ng voice (espeak:en-us+f3)
#MOUTH_VOICE=en_US-kristin-medium
# Speaking rate in words per minute (Piper scales its pace by speed/165)
#MOUTH_SPEED=165
# auto (Bluetooth speaker when connected, else the Ear's line-out), bluetooth or line-out
#MOUTH_SINK=auto
# Volume (%) set whenever a Bluetooth speaker connects; keep = leave it as it is
#MOUTH_BT_VOLUME=100
# 0 = hide and refuse scan/connect/disconnect/forget on the mouth page (pair with ./percept-kit.sh bt)
#MOUTH_BT_ADMIN=1
# Seconds of silence played before each sound on Bluetooth, and after MOUTH_BT_IDLE seconds of quiet
#MOUTH_BT_LEAD=0.3
#MOUTH_BT_IDLE_LEAD=1.0
#MOUTH_BT_IDLE=4
# Rendered phrases kept in the speech cache
#MOUTH_CACHE_MAX=300

# ---------------------------------------------------------------- voice sample
# One word the speech model knows (checked at start-up), e.g. computer; none = no wake word
#VOICE_WAKE_WORD=percept
# Seconds a bare wake word waits for the command
#VOICE_WAKE_WINDOW=5
# Ear input: mix (average of the four mics) or one mic, 0-3
#VOICE_MIC=mix
# Gain before recognition, in dB
#VOICE_GAIN_DB=12
# Voice for replies; empty = the mouth's MOUTH_VOICE
#VOICE_TTS_VOICE=
# Seconds the mic stays muted after a reply: line-out, and Bluetooth (which buffers)
#VOICE_ECHO_TAIL=0.4
#VOICE_ECHO_TAIL_BT=1.2
# Ignore Eye detections below this confidence
#VOICE_MIN_CONF=0.5
# Eye data older than this counts as "nothing seen"
#VOICE_STALE_SECONDS=2
# What "watch for people" watches for, and how arrivals and departures are judged
#VOICE_WATCH_LABEL=person
#VOICE_PRESENT_FRAMES=3
#VOICE_ABSENT_SECONDS=3
#VOICE_ALERT_COOLDOWN=30
# Snapshots kept (0 = all)
#VOICE_MAX_SNAPSHOTS=50
# 1 = have the mouth render (and cache) the fixed replies at start-up
#VOICE_PREWARM=1

# ---------------------------------------------------------------- dashboard
# Prometheus keeps this much history, whichever limit comes first
#PROMETHEUS_RETENTION=30d
#PROMETHEUS_RETENTION_SIZE=1GB

# ---------------------------------------------------------------- HDMI display
# console: the text login on the monitor (tty1); camera: the Eye's video full screen, no desktop (tty7).
#HDMI_MODE=console
# raw: camera only; result: detections drawn on the video. Both use the lower-resolution MJPEG feed.
#HDMI_FEED=result
# Monitor mode: 1280x720, 1024x768, 720x576 or 640x480 (one the monitor supports). 1080p doesn't fit in
# the display memory the GPU driver leaves free. The video is 816x616; the monitor fills its screen.
#HDMI_OUTPUT_MODE=1280x720
